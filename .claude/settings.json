{
  "permissions": {
    "allow": [
      "Bash(vercel *)",
      "Bash(git *)",
      "Bash(npx *)",
      "Bash(npm *)",
      "Bash(mkdir *)",
      "Bash(open *)",
      "mcp__Claude_Preview__preview_eval",
      "mcp__Claude_Preview__preview_screenshot",
      "mcp__Claude_Preview__preview_start",
      "mcp__Claude_Preview__preview_stop",
      "mcp__Claude_Preview__preview_snapshot",
      "mcp__Claude_Preview__preview_logs",
      "mcp__Claude_Preview__preview_click",
      "mcp__Claude_Preview__preview_list",
      "mcp__mcp-obsidian__obsidian_get_file_contents",
      "mcp__mcp-obsidian__obsidian_simple_search",
      "mcp__mcp-obsidian__obsidian_list_files_in_dir",
      "mcp__mcp-obsidian__obsidian_get_recent_changes",
      "mcp__mcp-obsidian__obsidian_get_recent_periodic_notes",
      "mcp__mcp-obsidian__obsidian_batch_get_file_contents"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "INPUT=$(cat); FILE=$(echo \"$INPUT\" | jq -r '.tool_input.file_path // empty'); cd \"/Users/pri/Documents/Start Ups/heirloom\" && git add -A && if ! git diff --cached --quiet; then BASENAME=$(basename \"$FILE\" 2>/dev/null || echo \"files\"); git commit -m \"Auto: edit $BASENAME\" && vercel --prod --yes 2>&1 | tail -5; fi",
            "async": true,
            "statusMessage": "Committing and deploying to Vercel..."
          }
        ]
      }
    ]
  }
}
